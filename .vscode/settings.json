{
    "liveServer.settings.port": 5501
}
main <section class="content-card"><p>Welcome</p></section></main>.content-card {
    padding: 16px;
    border: 2px solid navy;
}

.card-grid {
    display: grid;
    grid-template-columns: repeat (3,
    1fr);
    gap: 20px;
    margin-top: 30px;
}

.navigation {
    display: flex;
    flex-direction: row;
    gap: 12px;
}

@media (min-width: 768px) {
    .card-grid {
        grid-template-columns: repeat(3,
        1fr);
    }
}

.navigation {
    display: flex;
    flex-direction: column;
    justify-content: space-between align-items: center;
}

.navigation {
    display: flex;
    flex-wrap: wrap;
}